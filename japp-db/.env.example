# Copia a .env y ajusta. Nunca subas .env al repositorio.
# Usuario de la base: sa (créalo con: CREATE ROLE sa LOGIN PASSWORD '…' CREATEDB; y CREATE DATABASE japp OWNER sa;).
# sa_local es la clave de desarrollo: en una tienda pon una larga y la misma en japp-api/.env.
# Conexión con permiso para crear bases (las pruebas crean una base temporal y la borran al acabar)
DATABASE_ADMIN_URL=postgres://sa:sa_local@localhost:5432/postgres
# Base de trabajo local (npm run db:reset la recrea desde sql/)
DATABASE_URL=postgres://sa:sa_local@localhost:5432/japp
