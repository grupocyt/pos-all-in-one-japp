# Copia a .env (cp .env.example .env). Nunca subas .env a GitHub.
# Genera las dos claves con:
#   echo "SESSION_SECRET=$(openssl rand -hex 32)" >> .env
#   echo "DB_PASSWORD=$(openssl rand -hex 16)" >> .env
#
# Tienda
STORE_CODE=CT 03
PORT=8080
# 1 = cargar la Sucursal Pruebas (carta, usuarios de prueba) al crear la base. En una tienda real: 0
SEED=1
MANAGER_URL=https://japp.grupocyt.com.es/
STORE_KEY=
# Order on Table: clave que el sistema de pedidos del cliente manda en la cabecera X-Integration-Key.
# Vacía = /api/v2/oot/* responde 403. Genera una con: openssl rand -hex 32
OOT_INTEGRATION_KEY=
# Impresión: log (no imprime, para desarrollo) o escpos (envía a las impresoras tcp:// de Ajustes › Impresoras)
PRINTER_MODE=log
# Campo "mode" de todas las respuestas: developer (pruebas) o production (tienda real)
API_MODE=developer
# Orígenes que pueden llamar a la API desde otra web (separados por comas). Vacío = solo el TPV que sirve la propia API.
# Para probar un index.html abierto con doble clic (file://) o desde otro puerto: CORS_ORIGINS=*
CORS_ORIGINS=
#
# Agente de sincronización (apps/sync-agent): envía las transacciones de la cola (sync_outbox) al Manager.
# MANAGER_URL y STORE_KEY son las de arriba. La tienda: STORE_CODE (se busca store.id por code) o STORE_ID (UUID).
#STORE_ID=
SYNC_INTERVAL_SECONDS=60
SYNC_INSTANT=true
SYNC_DEBOUNCE_MS=2000
SYNC_BATCH=100
SYNC_GZIP=true
SYNC_MAX_ATTEMPTS=10
SYNC_RECONCILE_MINUTES=60
SYNC_HEARTBEAT_SECONDS=60
#
# Manager de pruebas (apps/fake-manager). Para usarlo con el agente:
#   MANAGER_URL=http://127.0.0.1:8090/api/manager/v1 y STORE_KEY = FAKE_MANAGER_STORE_KEY
FAKE_MANAGER_PORT=8090
FAKE_MANAGER_STORE_KEY=clave-de-pruebas-local
#
# Solo para la opción sin Docker y para npm test (con Docker se ignoran):
DATABASE_URL=postgres://japp:japp_local@localhost:5432/japp
DATABASE_ADMIN_URL=postgres://japp:japp_local@localhost:5432/postgres
# SESSION_SECRET y DB_PASSWORD: añádelas con los comandos de arriba
