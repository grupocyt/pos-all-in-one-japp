{
  "name": "japp-api",
  "private": true,
  "description": "Back de Japp TPV: API de tienda v2 (NestJS + Fastify + Drizzle + PostgreSQL) y reglas de negocio compartidas.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "contracts": "npm run generate -w @japp/contracts",
    "db:pull": "npm run db:pull -w @japp/db",
    "dev": "npm run dev -w store-api",
    "start": "npm start -w store-api",
    "db:init": "node ../japp-db/scripts/init.mjs",
    "format": "prettier --write \"apps/**/*.ts\" \"packages/domain/**/*.ts\" && eslint --fix \"apps/**/*.ts\" \"packages/domain/**/*.ts\" && prettier --write \"apps/**/*.ts\" \"packages/domain/**/*.ts\"",
    "lint": "eslint \"apps/**/*.ts\" \"packages/domain/**/*.ts\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "eslint": "9.13.0",
    "prettier": "3.3.3",
    "typescript-eslint": "8.11.0"
  }
}
